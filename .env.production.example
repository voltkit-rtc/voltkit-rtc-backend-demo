# Production settings. `./deploy.sh init` copies this to .env.production with fresh secrets filled in.
# Never commit .env.production.

# A domain whose DNS points at this server turns on HTTPS (ports 80 and 443 must be open).
# Leave it empty to serve plain http on API_PORT, for testing only.
DOMAIN=

# The port the API is published on when DOMAIN is empty.
API_PORT=4000

# MongoDB. Leave as is to run MongoDB in Docker beside the API.
# Your own database instead: any connection string. A database on this same server is host.docker.internal.
MONGODB_URI=mongodb://voltkit:CHANGE_ME@mongo:27017/voltkit_live?authSource=admin
# Used only by the MongoDB container.
MONGO_ROOT_USER=voltkit
MONGO_ROOT_PASSWORD=CHANGE_ME

# Signs guest sessions. At least 32 characters. Changing it signs every guest out.
JWT_SECRET=CHANGE_ME

# From your project's Credentials tab at https://voltkit.in/dashboard.
VOLTKIT_RTC_URL=https://rtc.voltkit.in
VOLTKIT_RTC_SECRET=

# Optional limits.
MAX_LIVE_ROOMS=50
STARTING_COINS=5000
TOPUP_COINS=2000
