{
  "name": "voltkit-live-backend",
  "version": "1.0.0",
  "description": "Backend for the VoltKit Live demo app: guests, rooms, tokens, gifts, chat and 1v1 matching.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 --test-timeout=15000 --test-force-exit test/*.test.js",
    "test:live": "node --env-file=.env test/live/voltkit.live.js"
  },
  "dependencies": {
    "@voltkit-rtc/server": "^0.4.11",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
