# Copy to .env.test. These values are only for `npm test`, which uses a fake VoltKit.
NODE_ENV=test

# WARNING: the tests delete this database between tests. Use a throwaway name, never real data.
MONGODB_URI=mongodb://127.0.0.1:27017/voltkit_live_test

JWT_SECRET=test-secret-test-secret-test-secret-1234
VOLTKIT_RTC_URL=https://rtc.example.test
VOLTKIT_RTC_SECRET=sk_test
RATE_LIMIT_SCALE=1000
