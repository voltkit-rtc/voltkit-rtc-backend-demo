NODE_ENV=development
PORT=4000
# Any MongoDB 6+ connection string.
MONGODB_URI=mongodb://user:password@127.0.0.1:27017/voltkit_live?authSource=admin
# Signs guest session tokens: `openssl rand -hex 32`. At least 32 characters.
JWT_SECRET=
# From your project's Credentials tab on https://voltkit.in/dashboard. Keep the secret on the server.
VOLTKIT_RTC_URL=https://rtc.voltkit.in
VOLTKIT_RTC_SECRET=
# Optional:
# TRUST_PROXY=1          # how many proxies sit in front of this server, for real client addresses
# MAX_LIVE_ROOMS=50
# STARTING_COINS=5000
# TOPUP_COINS=2000
